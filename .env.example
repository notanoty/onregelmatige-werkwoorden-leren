# Umami analytics (self-hosted at http://146.190.229.9:3005).
# Each deployment (production/www vs dev subdomain) should point at its own
# "website" entry in the Umami dashboard, so traffic is tracked separately.
#
# Production (main branch / www.onregelmatige-werkwoorden-leren.com):
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID=<uuid for the www site>
#   NEXT_PUBLIC_UMAMI_DOMAINS=onregelmatige-werkwoorden-leren.com,www.onregelmatige-werkwoorden-leren.com
#
# Dev (dev branch / dev.onregelmatige-werkwoorden-leren.com):
#   NEXT_PUBLIC_UMAMI_WEBSITE_ID=<uuid for the dev site>
#   NEXT_PUBLIC_UMAMI_DOMAINS=dev.onregelmatige-werkwoorden-leren.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=
